{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "[ -f \"${CLAUDE_PROJECT_DIR:-.}/graphify-out/.graphify_extracting\" ] || graphify hook-guard search",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Read|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "[ -f \"${CLAUDE_PROJECT_DIR:-.}/graphify-out/.graphify_extracting\" ] || graphify hook-guard read",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
